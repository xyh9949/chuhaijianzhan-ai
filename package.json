{
  "name": "form-studio",
  "version": "0.42.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3200",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3200",
    "typecheck": "tsc --noEmit",
    "setup": "tsx scripts/setup.ts",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts tests/*.test.tsx src/server/__tests__/*.test.ts",
    "test:auth": "tsx scripts/auth-smoke.ts",
    "test:http": "tsx tests/http-integration.ts",
    "test:ui": "node scripts/test-ui.cjs",
    "test:ui:list": "node scripts/test-ui.cjs --list",
    "test:ui:policy": "node --test tests/ui/runner-policy.test.cjs",
    "test:ui:install": "playwright install chromium",
    "test:ui:report": "node scripts/test-ui.cjs --report",
    "backup": "node scripts/backup.cjs",
    "ops": "node scripts/ops.cjs",
    "test:deployment": "node tests/deployment-integration.cjs"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@ant-design/icons": "6.3.4",
    "@ant-design/nextjs-registry": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "1.1.0",
    "@puckeditor/core": "0.24.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "acorn": "8.19.0",
    "antd": "6.7.0",
    "better-auth": "1.7.18",
    "better-sqlite3": "13.0.3",
    "exceljs": "4.4.0",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "playwright-core": "1.65.0",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.7",
    "postcss-value-parser": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "ssf": "0.11.2",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1",
      "unzipper": "0.12.5"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0 <23"
  }
}
