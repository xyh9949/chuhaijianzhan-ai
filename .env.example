# 优先运行 npm run setup，由工具生成每个实例独立的随机密钥。
BETTER_AUTH_URL=http://127.0.0.1:3200
FORM_STUDIO_DATA_DIR=./data
# BETTER_AUTH_SECRET=由 setup 生成；不要沿用其他客户实例的密钥

# 新实例优先在“站点设置 → 邮件通知”配置；以下是旧部署的环境回退，后台保存后以私有配置为准。
# 网站询盘始终先入库。none=不外发，mock=进程内模拟，smtp=真实邮件。
FORM_STUDIO_NOTIFY_TRANSPORT=none
# FORM_STUDIO_NOTIFY_TO=sales@example.com
# FORM_STUDIO_SMTP_FROM=website@example.com
# FORM_STUDIO_SMTP_HOST=smtp.example.com
# FORM_STUDIO_SMTP_PORT=587
# FORM_STUDIO_SMTP_SECURE=false
# FORM_STUDIO_SMTP_USER=按供应商配置
# FORM_STUDIO_SMTP_PASSWORD=只保存在服务器私有环境中
# 仅反向代理覆盖X-Forwarded-For且已阻止绕过代理时开启额外IP限流。
FORM_STUDIO_TRUST_PROXY=false

# 搜索更新对外通知仅运维显式开启；默认不发送，key为IndexNow公开所有权文件，不是账户密钥。
FORM_STUDIO_INDEXNOW_ENABLED=false
# FORM_STUDIO_INDEXNOW_KEY=部署实例独立生成的8至128位字母数字或连字符
# 最小公开页抓取计数，UA仅声称身份、UTC聚合保留30天；不记录IP/Cookie/查询串。
FORM_STUDIO_CRAWL_LOG=false

# AI视觉检查按需使用服务器已有的Chrome、Edge或Chromium，不自动下载浏览器。
# 不填写时自动检测；指定后只使用该种浏览器：chromium、chrome、msedge。
# FORM_STUDIO_VISUAL_BROWSER_CHANNEL=chrome
# 设为1可关闭本机截图，其余AI设计和手工编辑照常可用。
# FORM_STUDIO_VISUAL_DISABLED=1
# 反代部署可指定内部预览来源，只允许与登录来源相同或本机回环来源。
# FORM_STUDIO_VISUAL_ORIGIN=http://127.0.0.1:3200
